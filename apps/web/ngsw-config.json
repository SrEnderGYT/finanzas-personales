{
  "$schema": "../../node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "appData": { "shell": "p17-login-first" },
  "dataGroups": [],
  "assetGroups": [
    {
      "name": "shell",
      "installMode": "prefetch",
      "resources": {
        "files": ["/index.html", "/*.css", "/*.js", "/manifest.webmanifest", "/icons/**"]
      }
    }
  ],
  "navigationUrls": [
    "/**",
    "!/**/*.*",
    "!/v1/**",
    "!/health",
    "!/mobile/**",
    "!/mobile",
    "!/finanzas-personales/mobile/**",
    "!/finanzas-personales/mobile"
  ]
}
